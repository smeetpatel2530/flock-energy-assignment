{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "description": "A clean, read-only API over the Urja Meter Ops smart-meter portal. See PROTOCOL.md for how the underlying portal works.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness check (does not contact the portal)",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "List and filter meters",
        "operationId": "list_meters_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring of meter ID or serial number",
              "title": "Q"
            },
            "description": "Substring of meter ID or serial number"
          },
          {
            "name": "install_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "faulty"
              ],
              "title": "Install Status"
            }
          },
          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "ct_operated"
              ],
              "title": "Install Type"
            }
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "three"
              ],
              "title": "Phase Type"
            }
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "Genus"
              ],
              "title": "Make"
            }
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "DT-001"
              ],
              "title": "Dt Code"
            }
          },
          {
            "name": "feeder_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [
                "F-001"
              ],
              "title": "Feeder Code"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterPage"
                }
              }
            }
          },
          "502": {
            "description": "Portal rejected our credentials or sent an unusable response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Portal unreachable or rate limiting us",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get one meter with its nameplate, location and network position",
        "operationId": "get_meter_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meter"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Portal rejected our credentials or sent an unusable response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Portal unreachable or rate limiting us",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Latest available energy readings for a meter, with per-interval consumption",
        "operationId": "get_consumption_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Consumption"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Portal rejected our credentials or sent an unusable response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Portal unreachable or rate limiting us",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/network": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "Network hierarchy (zone to DT) with meter counts and a data-quality report",
        "operationId": "get_network_network_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Network"
                }
              }
            }
          },
          "502": {
            "description": "Portal rejected our credentials or sent an unusable response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Portal unreachable or rate limiting us",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/transformers": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "List distribution transformers",
        "operationId": "list_transformers_transformers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Transformer"
                  },
                  "type": "array",
                  "title": "Response List Transformers Transformers Get"
                }
              }
            }
          },
          "502": {
            "description": "Portal rejected our credentials or sent an unusable response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Portal unreachable or rate limiting us",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CodeUnderManyParents": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ],
            "title": "Level"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "parent_codes": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Parent Codes",
            "description": "Distinct parent codes seen for this code."
          }
        },
        "type": "object",
        "required": [
          "level",
          "code",
          "parent_codes"
        ],
        "title": "CodeUnderManyParents"
      },
      "CodeWithManyNames": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ],
            "title": "Level"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names"
          }
        },
        "type": "object",
        "required": [
          "level",
          "code",
          "names"
        ],
        "title": "CodeWithManyNames"
      },
      "Consumption": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "interval_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Minutes",
            "description": "Typical spacing between readings: 30 or 1440 have been observed. Null if fewer than two readings."
          },
          "period_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Start"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period End"
          },
          "total_kwh_consumed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Kwh Consumed",
            "description": "kWh consumed between the first and last reading."
          },
          "skipped_rows": {
            "type": "integer",
            "title": "Skipped Rows",
            "description": "Portal rows dropped because they were duplicated or had no usable kWh value."
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "interval_minutes",
          "period_start",
          "period_end",
          "total_kwh_consumed",
          "skipped_rows",
          "readings"
        ],
        "title": "Consumption"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "examples": [
              "meter_not_found"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Location"
      },
      "Meter": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "examples": [
              "J100001"
            ]
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number",
            "examples": [
              "GE84132"
            ]
          },
          "make": {
            "type": "string",
            "title": "Make",
            "examples": [
              "L&T"
            ]
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type",
            "description": "Observed values: single, three.",
            "examples": [
              "single"
            ]
          },
          "install_status": {
            "type": "string",
            "title": "Install Status",
            "description": "Observed values: installed, faulty, decommissioned.",
            "examples": [
              "installed"
            ]
          },
          "install_type": {
            "type": "string",
            "title": "Install Type",
            "description": "Observed values: ct_operated, whole_current.",
            "examples": [
              "ct_operated"
            ]
          },
          "dt_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dt Code",
            "description": "Distribution transformer the meter is fed from."
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "network": {
            "items": {
              "$ref": "#/components/schemas/NetworkNode"
            },
            "type": "array",
            "title": "Network",
            "description": "Position in the network, ordered from zone down to distribution transformer."
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "serial_number",
          "make",
          "phase_type",
          "install_status",
          "install_type",
          "dt_code",
          "location",
          "network"
        ],
        "title": "Meter"
      },
      "MeterPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Meter"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "MeterPage"
      },
      "MissingValues": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ],
            "title": "Level"
          },
          "meters_missing_code": {
            "type": "integer",
            "title": "Meters Missing Code"
          },
          "meters_missing_name": {
            "type": "integer",
            "title": "Meters Missing Name"
          }
        },
        "type": "object",
        "required": [
          "level",
          "meters_missing_code",
          "meters_missing_name"
        ],
        "title": "MissingValues"
      },
      "Network": {
        "properties": {
          "zones": {
            "items": {
              "$ref": "#/components/schemas/NetworkTreeNode"
            },
            "type": "array",
            "title": "Zones",
            "description": "Hierarchy built from every meter's own path. A node is identified by its full path from the zone, so a code reused under two parents appears as two nodes."
          },
          "data_quality": {
            "$ref": "#/components/schemas/NetworkDataQuality"
          }
        },
        "type": "object",
        "required": [
          "zones",
          "data_quality"
        ],
        "title": "Network"
      },
      "NetworkDataQuality": {
        "properties": {
          "codes_under_many_parents": {
            "items": {
              "$ref": "#/components/schemas/CodeUnderManyParents"
            },
            "type": "array",
            "title": "Codes Under Many Parents",
            "description": "Codes that appear under more than one parent. The portal does not say whether codes are unique only within their parent or the links are inconsistent."
          },
          "codes_with_many_names": {
            "items": {
              "$ref": "#/components/schemas/CodeWithManyNames"
            },
            "type": "array",
            "title": "Codes With Many Names"
          },
          "missing_values": {
            "items": {
              "$ref": "#/components/schemas/MissingValues"
            },
            "type": "array",
            "title": "Missing Values",
            "description": "Only levels with at least one gap are listed."
          }
        },
        "type": "object",
        "required": [
          "codes_under_many_parents",
          "codes_with_many_names",
          "missing_values"
        ],
        "title": "NetworkDataQuality"
      },
      "NetworkNode": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "description": "Node code, e.g. 'F-001'. Null when the portal has none."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Display name. Null when the portal has none."
          }
        },
        "type": "object",
        "required": [
          "level",
          "code",
          "name"
        ],
        "title": "NetworkNode"
      },
      "NetworkTreeNode": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ],
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "meter_count": {
            "type": "integer",
            "title": "Meter Count",
            "description": "Meters at or below this node."
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/NetworkTreeNode"
            },
            "type": "array",
            "title": "Children",
            "description": "Child nodes. Empty at DT level; use GET /meters?dt_code=... for its meters."
          }
        },
        "type": "object",
        "required": [
          "level",
          "code",
          "name",
          "meter_count",
          "children"
        ],
        "title": "NetworkTreeNode"
      },
      "Reading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Local time as reported by the portal (no timezone given; assumed Asia/Kolkata)."
          },
          "kwh_register": {
            "type": "number",
            "title": "Kwh Register",
            "description": "Cumulative active-energy register (kWh)."
          },
          "kvah_register": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah Register",
            "description": "Cumulative apparent-energy register (kVAh)."
          },
          "voltage_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage R",
            "description": "R-phase voltage (V)."
